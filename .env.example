# ─── Copier ce fichier en `.env` (jamais de secret dans ce fichier d'exemple) ───

# Port d'écoute (Docker et Node)
PORT=3000

# URL publique du site (canonical, hreflang, sitemap, Open Graph)
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Affiche, sur chaque placeholder d'image, le nom du fichier attendu (true/false)
NUXT_PUBLIC_SHOW_PLACEHOLDERS=false

# ─── Formulaire de contact (/api/contact) ───
# Sans SMTP configuré : le message est écrit dans les journaux et un succès « démo » est renvoyé.
NUXT_CONTACT_TO=
NUXT_CONTACT_FROM=
NUXT_SMTP_HOST=
NUXT_SMTP_PORT=587
NUXT_SMTP_SECURE=false
NUXT_SMTP_USER=
NUXT_SMTP_PASS=
